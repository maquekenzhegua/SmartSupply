    "vue-echarts": "^6.6.1",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
