# SmartSupply 环境变量模板 —— 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，切勿提交明文
# ===== 本地 docker-compose 演示 =====
POSTGRES_DB=smartsupply
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me-strong-password

# ===== VMware 直连（按需修改 VM_IP）=====
VM_IP=192.168.1.100  # 示例：替换为你的虚拟机/云服务器 IP
SPRING_DATASOURCE_URL=jdbc:postgresql://${VM_IP}:5432/smartsupply
SPRING_DATASOURCE_USERNAME=dev
SPRING_DATASOURCE_PASSWORD=change-me-strong-password
SPRING_DATA_REDIS_HOST=${VM_IP}
SPRING_DATA_REDIS_PORT=6379
# Redis 无用户名，仅密码（VM 已配置 requirepass）
SPRING_DATA_REDIS_PASSWORD=change-me-redis-password
# MySQL 保留给其他业务，本项目主库为 PG 向量库，暂不直连
MYSQL_HOST=${VM_IP}
MYSQL_USER=java_dev
MYSQL_PASSWORD=change-me-mysql-password

# ===== 模型接入 =====
# 任一 OpenAI 兼容端点：OpenAI / DeepSeek / 智谱 / DashScope compatible-mode / vLLM
# 示例：OPENAI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
#       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode  AI_MODEL=qwen-plus
# 注意：DeepSeek 无 /embeddings；embedding 建议走 OpenAI text-embedding-3-small(1536维) 或智谱等，
#       换维度时同步修改 VECTOR_DIMENSIONS 与 pgvector 迁移列宽
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
# 向量维度（须与 pgvector 列一致）：默认 1024 对应本地 Ollama qwen3-embedding:0.6b/bge-m3；
# 换 OpenAI text-embedding-3-small 时改 1536，并同步建表列宽
VECTOR_DIMENSIONS=1024
# Embedding 端点（可独立于 Chat）：本地 Ollama 免费，OpenAI 兼容 /v1/embeddings
# OLLAMA_EMBED=1 时启用下方 Ollama 配置
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 强制 Embedding 走 Mock（哈希伪向量，检索无语义）；不设则按端点自动判断
EMBEDDING_MOCK=false
# 离线演示开关：true=Chat/Embedding 全 Mock
AI_MOCK=true
JWT_SECRET=change-me-32chars-minimum-secret-please
AGENT_PYTHON_ENABLED=false
AGENT_PYTHON_URL=http://127.0.0.1:8001
