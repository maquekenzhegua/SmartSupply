# SmartSupply 环境变量模板 —— 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，切勿提交明文
# ===== 本地 docker-compose 演示 =====
POSTGRES_DB=smartsupply
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me-strong-password

# ===== VMware 直连（按需修改 VM_IP）=====
VM_IP=192.168.1.100  # 示例：替换为你的虚拟机/云服务器 IP
SPRING_DATASOURCE_URL=jdbc:postgresql://${VM_IP}:5432/smartsupply
SPRING_DATASOURCE_USERNAME=dev
SPRING_DATASOURCE_PASSWORD=change-me-strong-password
SPRING_DATA_REDIS_HOST=${VM_IP}
SPRING_DATA_REDIS_PORT=6379
# Redis 无用户名，仅密码（VM 已配置 requirepass）
SPRING_DATA_REDIS_PASSWORD=change-me-redis-password
# MySQL 保留给其他业务，本项目主库为 PG 向量库，暂不直连
MYSQL_HOST=${VM_IP}
MYSQL_USER=java_dev
MYSQL_PASSWORD=change-me-mysql-password

# ===== 模型接入 =====
# 任一 OpenAI 兼容端点：OpenAI / DeepSeek / 智谱 / DashScope compatible-mode / vLLM
# 示例：OPENAI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
#       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode  AI_MODEL=qwen-plus
# opencode zen/go 套餐（本项目默认推理模型）：只有 MiMo V2.5 走标准 /chat/completions；
#   若用 muse-spark 模型，后端 MuseSparkChatModel 会自动切 /responses 协议
#   OPENAI_BASE_URL=https://opencode.ai/zen/go/v1  AI_MODEL=mimo-v2.5
# 注意：DeepSeek 无 /embeddings；embedding 走本地 Ollama（见下），不用网关自带
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
# 向量维度（须与 pgvector 列一致）：默认 1024 对应本地 Ollama qwen3-embedding:0.6b/bge-m3；
# 换 OpenAI text-embedding-3-small 时改 1536，并同步建表列宽
VECTOR_DIMENSIONS=1024
# Embedding 端点（可独立于 Chat）：本地 Ollama 免费，OpenAI 兼容 /v1/embeddings
# OLLAMA_EMBED=1 时启用下方 Ollama 配置
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 强制 Embedding 走 Mock（哈希伪向量，检索无语义）；不设则按端点自动判断
EMBEDDING_MOCK=false
# 离线演示开关：prod 编排强制显式设置（:?，缺省即启动失败）——true=Chat/Embedding 全
# Mock（启动横幅与 /api/agent/mode 会显式提示）；false=接真实模型（需 OPENAI_API_KEY）
AI_MOCK=true
JWT_SECRET=change-me-32chars-minimum-secret-please
# 演示账号口令（启动时以真实 BCrypt 哈希写入 sys_user；prod 必须覆盖默认值）
# DEMO_ADMIN_PASSWORD=admin123
# DEMO_OPS_PASSWORD=ops123
AGENT_PYTHON_ENABLED=false
AGENT_PYTHON_URL=http://127.0.0.1:8001

# ===== Python 边车工具回环鉴权（深度模式）=====
# 边车回环调用 Java 只读工具需带 JWT。主路径：Java /chat 把发起用户的 JWT 经
# Authorization 头透传给边车（/api/reason），边车回环时带上同一 token → 审计归属真实用户。
# 因此通常无需再单独配 JAVA_JWT_TOKEN。以下仅用于"边车被直接调用（无用户上下文）"时的兜底：
#   JAVA_JWT_TOKEN：手工指定一个长期 token（优先级高于自动登录，注意其权限面）
#   SIDECAR_USERNAME/SIDECAR_PASSWORD：边车自动登录换取 token 用的演示账号。
#     安全修复后默认留空（fail-closed）：不配置则边车直调场景的工具回环如实 401，
#     不再内置 admin/admin123 弱口令。需要该能力必须显式填写专用低权限账号。
# JAVA_JWT_TOKEN=
# SIDECAR_USERNAME=
# SIDECAR_PASSWORD=
# ReAct 最大迭代轮数（默认 6）：取证深度与成本上限，按环境调整
# MAX_ITERATIONS=6

# ===== Java ↔ 边车服务间鉴权 =====
# 两端配置同一随机值后，/api/reason* 要求 X-Api-Key 匹配（不设则本地开发零配置可用）
# AGENT_PYTHON_API_KEY=generate-a-random-key
# SIDECAR_API_KEY=generate-a-random-key

# ===== 重排模型 =====
# cross-encoder 默认 BAAI/bge-reranker-base（中文友好）；权重不可用时自动回退词面打分
# RERANK_CROSS_MODEL=BAAI/bge-reranker-base

# ===== 可观测性：Langfuse（可选，不配置即禁用，零依赖）=====
# 生产自部署（组合编排，obs 服务密钥可强制必填）：
#   docker compose -f docker-compose.prod.yml -f docker-compose.obs.yml up -d
# 本地开发（弱密钥演示即可）：docker compose --profile obs up -d
# 注册账号并创建项目，把生成的 key 填到下面两端（Java/边车共用一份即可，边车侧实际消费）
# 配置后：一次 agent 运行 = 一条 trace（planner/工具/reasoner 全埋点，含真实 token 用量）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth-secret
# LANGFUSE_SALT=change-me-langfuse-salt

# ===== 可观测性：Prometheus / Grafana / Alertmanager（可选，随 docker-compose.obs.yml）=====
# 指标已由 Micrometer 暴露（agent.chat.latency/tokens/cost、tool、rag 等），
# 告警规则见 deploy/observability/alerts.yml，通知渠道在 alertmanager.yml 里接入
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ===== HITL 写操作（LangGraph interrupt/resume）=====
# 深度模式下 Agent 规划出 create_purchase_order 时，图在执行前挂起（interrupt），
# 前端弹出"批准/拒绝"，批准后携 Command(resume) 恢复执行；写操作本身在 Java 侧
# 强制 ADMIN 角色 + 幂等 + DRAFT 状态（见 /api/agent/purchase-orders）。无需额外环境变量。

# ===== MCP 服务器（app/mcp_server.py，stdio 传输）=====
# 把边车工具按开放协议暴露给任意 MCP 客户端（Claude Desktop/IDE Agent）。
# 7 个只读工具默认可用；写工具默认不暴露——MCP 通道无图内 interrupt 人工批准环节，
# 确需开启（如运维 Copilot 场景）设 1，Java 侧 ADMIN/幂等/DRAFT 审批仍然生效。
# MCP_ENABLE_WRITE=1

# ===== checkpointer 持久化（可选，缺省进程内 MemorySaver）=====
# interrupt 挂起的待审批 run 依赖 checkpoint 存活；MemorySaver 随边车重启丢失。
# 配置 Postgres URI 后挂起状态落库（checkpoint_* 表由边车首次启动幂等建表），
# 重启/多实例部署仍可恢复；Postgres 不可达时自动降级进程内并大声告警。
# compose 编排已默认注入（dev/prod 均指向 postgres 服务），本地裸跑边车才需要手工配置：
# CHECKPOINT_URI=postgresql://dev:change-me-strong-password@localhost:5432/smartsupply
